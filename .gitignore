# Secrets and personal data. Nothing here is safe to publish:
# the config files hold secret calendar URLs (read access to real calendars),
# family email addresses, and account identifiers.
config.*.json
!config.example.json
!config.example.*.json
config.json
*.superseded
*.bak
.env

# Generated pages and fetched source data - real email, tasks, calendars.
out/
out-*/
data/
data-*/
publish/
publish-*/
logs/

# Local
__pycache__/
*.pyc
.DS_Store

# LaunchAgent plists are generated by make_plist.py - they hold an absolute
# home directory and a profile name.
com.*.plist
!com.example.flex-dashboard.plist
